@echo off
setlocal
set "PROJECT_ROOT=%~dp0"

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath($env:PROJECT_ROOT); $server=Join-Path $root 'server.js'; $pidFile=Join-Path $root '.mc-viewer-server.pid'; $url='http://127.0.0.1:4173/'; $viewerPattern='(?is)<title[^>]*>[^<]*MC Viewer[^<]*Tu taller de estructuras[^<]*</title>'; $page=$null; try { $page=Invoke-WebRequest -Uri $url -TimeoutSec 2 -UseBasicParsing -ErrorAction Stop } catch {}; if($page -and $page.StatusCode -eq 200 -and $page.Content -match $viewerPattern){ Write-Host 'MC Viewer ya responde en http://127.0.0.1:4173/; no se lanzó otro proceso ni se creó un PID.'; exit 0 }; $tcp=New-Object System.Net.Sockets.TcpClient; $portBusy=$false; try { $connect=$tcp.ConnectAsync('127.0.0.1',4173); $done=$connect.Wait(800); $portBusy=$done -and $tcp.Connected } catch { $portBusy=$tcp.Connected } finally { $tcp.Dispose() }; if($portBusy){ Write-Host 'Conflicto: el puerto 4173 está ocupado, pero no se pudo confirmar que responda MC Viewer. No se inició ni detuvo ningún proceso.'; exit 1 }; $node=$env:NODE_REPL_NODE_PATH; if(!$node -or !(Test-Path -LiteralPath $node)){ $node=$null; $pathNode=Get-Command node.exe -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1; if($pathNode){$node=$pathNode.Source} }; if(!$node){ $runtimeRoot=Join-Path $env:LOCALAPPDATA 'OpenAI/Codex/runtimes/cua_node'; $runtimePattern=Join-Path $runtimeRoot '*/bin/node.exe'; $runtimeNode=Get-ChildItem -Path $runtimePattern -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if($runtimeNode){$node=$runtimeNode.FullName} }; if(!$node){ $cachedNode=Join-Path $env:USERPROFILE '.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe'; if(Test-Path -LiteralPath $cachedNode){$node=$cachedNode} }; if(!$node -or !(Test-Path -LiteralPath $node)){ Write-Host 'Error: no se encontró node.exe en PATH ni en los runtimes configurados de Codex.'; exit 1 }; $env:HOST='127.0.0.1'; $env:PORT='4173'; $outLog=Join-Path $env:TEMP 'mc-viewer-4173.stdout.log'; $errLog=Join-Path $env:TEMP 'mc-viewer-4173.stderr.log'; Remove-Item -LiteralPath $outLog,$errLog -Force -ErrorAction SilentlyContinue; $nodeArgs=[string][char]34+$server+[char]34; try { $p=Start-Process -FilePath $node -ArgumentList $nodeArgs -WorkingDirectory $root -WindowStyle Hidden -PassThru -RedirectStandardOutput $outLog -RedirectStandardError $errLog } catch { Write-Host ('No se pudo iniciar Node: '+$_.Exception.Message); exit 1 }; $deadline=(Get-Date).AddSeconds(15); $ready=$false; while((Get-Date) -lt $deadline){ $p.Refresh(); if($p.HasExited){break}; try { $check=Invoke-WebRequest -Uri $url -TimeoutSec 2 -UseBasicParsing -ErrorAction Stop; if($check.StatusCode -eq 200 -and $check.Content -match $viewerPattern){ $p.Refresh(); if(!$p.HasExited){$ready=$true; break} } } catch {}; Start-Sleep -Milliseconds 350 }; if($ready){ try { Set-Content -LiteralPath $pidFile -Value $p.Id -NoNewline -ErrorAction Stop } catch { Write-Host ('MC Viewer respondió, pero no se pudo registrar el PID '+$p.Id+': '+$_.Exception.Message); Write-Host 'La instancia queda en ejecución sin registro; no se detuvo ningún proceso.'; exit 1 }; Write-Host 'Servidor iniciado y verificado en http://127.0.0.1:4173/.'; Write-Host ('PID registrado: '+$p.Id); exit 0 }; $p.Refresh(); if($p.HasExited){ Write-Host 'Node se cerró antes de que MC Viewer respondiera por HTTP.' } else { $identityVerified=$false; $identityError=$null; try { $owned=Get-CimInstance Win32_Process -Filter ('ProcessId='+$p.Id) -ErrorAction Stop; if($owned -and $owned.ProcessId -eq $p.Id -and $owned.Name -ieq 'node.exe' -and $owned.CommandLine -and $owned.ExecutablePath){ $expectedNode=[IO.Path]::GetFullPath($node); $actualNode=[IO.Path]::GetFullPath($owned.ExecutablePath); $quotedServer=[string][char]34+$server+[char]34; if([string]::Equals($expectedNode,$actualNode,[StringComparison]::OrdinalIgnoreCase) -and $owned.CommandLine.IndexOf($quotedServer,[StringComparison]::OrdinalIgnoreCase) -ge 0){$identityVerified=$true} } } catch { $identityError=$_.Exception.Message }; if($identityVerified){ try { Stop-Process -Id $p.Id -Force -ErrorAction Stop; Wait-Process -Id $p.Id -Timeout 5 -ErrorAction SilentlyContinue; if(Get-Process -Id $p.Id -ErrorAction SilentlyContinue){ Write-Host ('El Node iniciado por este script (PID '+$p.Id+') fue verificado, pero sigue activo después del intento de cierre.') } else { Write-Host ('MC Viewer no respondió en 15 segundos; se detuvo únicamente el Node recién iniciado y verificado (PID '+$p.Id+').') } } catch { Write-Host ('MC Viewer no respondió y no se pudo detener el Node verificado (PID '+$p.Id+'): '+$_.Exception.Message) } } else { $message='MC Viewer no respondió en 15 segundos. No se detuvo ningún proceso porque no se pudo verificar con seguridad que el PID '+$p.Id+' corresponda al Node recién iniciado ejecutando el server.js de esta carpeta.'; if($identityError){$message+=' Verificación: '+$identityError}; Write-Host $message } }; $details=''; if(Test-Path -LiteralPath $errLog){$details=Get-Content -LiteralPath $errLog -Raw -ErrorAction SilentlyContinue}; if($details){ Write-Host 'Detalle de Node:'; Write-Host $details.Trim() }; if($p.HasExited){ Remove-Item -LiteralPath $outLog,$errLog -Force -ErrorAction SilentlyContinue }; exit 1 }"
if errorlevel 1 pause
