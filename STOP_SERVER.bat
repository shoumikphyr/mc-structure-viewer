@echo off
setlocal
set "PROJECT_ROOT=%~dp0"

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath($env:PROJECT_ROOT); $server=Join-Path $root 'server.js'; $pidFile=Join-Path $root '.mc-viewer-server.pid'; if(!(Test-Path -LiteralPath $pidFile)){ Write-Host 'No hay una instancia registrada por START_SERVER.bat. No se buscaron ni detuvieron procesos.'; exit 0 }; $serverPid=0; $rawPid=Get-Content -LiteralPath $pidFile -Raw -ErrorAction Stop; if(![int]::TryParse($rawPid.Trim(),[ref]$serverPid) -or $serverPid -le 0){ Remove-Item -LiteralPath $pidFile -Force; Write-Host 'El PID registrado no es válido; se limpió el archivo y no se detuvo ningún proceso.'; exit 1 }; try { $proc=Get-CimInstance Win32_Process -Filter ('ProcessId='+$serverPid) -ErrorAction Stop } catch { Write-Host ('No se pudo verificar la identidad del PID '+$serverPid+'. No se detuvo ningún proceso y el registro se conservó. '+$_.Exception.Message); exit 1 }; if(!$proc){ Remove-Item -LiteralPath $pidFile -Force; Write-Host 'El proceso registrado ya no existe; se limpió el PID obsoleto.'; exit 0 }; $quotedServer=[string][char]34+$server+[char]34; if($proc.Name -ine 'node.exe' -or !$proc.CommandLine -or $proc.CommandLine.IndexOf($quotedServer,[StringComparison]::OrdinalIgnoreCase) -lt 0){ Remove-Item -LiteralPath $pidFile -Force; Write-Host 'El PID ya no corresponde a node.exe ejecutando el server.js de esta carpeta. No se detuvo ningún proceso.'; exit 1 }; try { Stop-Process -Id $serverPid -Force -ErrorAction Stop; Wait-Process -Id $serverPid -Timeout 5 -ErrorAction SilentlyContinue } catch { Write-Host ('No se pudo detener la instancia registrada: '+$_.Exception.Message); exit 1 }; $remaining=Get-Process -Id $serverPid -ErrorAction SilentlyContinue; if($remaining){ Write-Host 'El proceso sigue activo; se conserva el PID para evitar perder su registro.'; exit 1 }; Remove-Item -LiteralPath $pidFile -Force; Remove-Item -LiteralPath (Join-Path $env:TEMP 'mc-viewer-4173.stdout.log'),(Join-Path $env:TEMP 'mc-viewer-4173.stderr.log') -Force -ErrorAction SilentlyContinue; Write-Host 'Se detuvo únicamente la instancia registrada de este proyecto.'; exit 0 }"
if errorlevel 1 pause
